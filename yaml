name: Build Minecraft Mod

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    
    - name: Set up JDK 21
      uses: actions/setup-java@v4
      with:
        java-version: '21'
        distribution: 'temurin'

    - name: Download Gradle Wrapper
      run: |
        curl -L https://githubusercontent.com -o gradlew
        curl -L https://githubusercontent.com -o gradle/wrapper/gradle-wrapper.jar
        curl -L https://githubusercontent.com -o gradle/wrapper/gradle-wrapper.properties
        chmod +x gradlew
        
    - name: Build Mod
      run: ./gradlew build

    - name: Upload Mod File
      uses: actions/upload-artifact@v4
      with:
        name: UltraVision-Mod
        path: build/libs/*.jar
